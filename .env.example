RETAILPILOT_DB=.data/retailpilot-live.db
# rules is the offline default. No key is needed.
RETAILPILOT_MODEL_PROVIDER=rules
# Optional initial service configured by the operator.
# Admins can configure models in the web UI; saved web settings take precedence.
# RETAILPILOT_MODEL_PROVIDER=openai-compatible
# RETAILPILOT_MODEL_BASE_URL=https://api.openai.com/v1
# RETAILPILOT_MODEL_NAME=your-structured-output-model
# RETAILPILOT_MODEL_API_KEY=configure-in-private-environment
# RETAILPILOT_MODEL_MAX_OUTPUT=800
# RETAILPILOT_MODEL_DAILY_BUDGET=100000
